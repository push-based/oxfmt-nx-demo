{
  "printWidth": 80,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@org/"],
    "partitionByComment": true
  },
  "ignorePatterns": [".yarn/releases"],
  "associations": [
    {
      "files": ["**/*.html"],
      "excludeFiles": ["**/index.html", "**/public/**", "**/templates/**"],
      "language": "angular-html"
    }
  ]
}
