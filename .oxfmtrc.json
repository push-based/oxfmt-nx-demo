{
  "printWidth": 80,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@org/"],
    "partitionByComment": true
  },
  "ignorePatterns": ["*.html", "!*.component.html"]
}
